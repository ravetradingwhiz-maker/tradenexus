# Deriv OAuth 2.0 (PKCE) client id — from https://app.deriv.com/account/api-token
CLIENT_ID=
# Legacy Deriv app id (used by the classic token redirect + legacy WS).
APP_ID=

# Optional: force a specific OAuth redirect URI. Defaults to the page origin.
REDIRECT_URL=

# Set TUNNEL=1 when dev-serving through an https tunnel (ngrok/cloudflare).
TUNNEL=

# Backend API base URL. Leave EMPTY in dev — requests go same-origin (/api) and
# the Vite dev server proxies them to localhost:4100 (see vite.config.ts).
# In PRODUCTION set this to the backend's public URL (baked in at build time):
#   API_URL=https://api.yourdomain.com
API_URL=

# Canonical public site URL, used for SEO tags (canonical/OG/JSON-LD).
SITE_URL=https://derivbot.app
