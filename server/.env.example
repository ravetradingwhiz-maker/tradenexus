PORT=4100
# Public URL of THIS server — used to build the crypto IPN callback URL.
SERVER_PUBLIC_URL=

# Browser origins allowed to call the API (the frontend).
ALLOWED_ORIGIN_1=http://localhost:5173
ALLOWED_ORIGIN_2=https://derivbot.app
ALLOWED_ORIGIN_3=

MONGODB_URI=

# ── Deriv markup reporting (admin) ───────────────────────────────────────────
MARKUP_API_TOKEN=
MARKUP_APP_ID=

# ═════════════════════════════════════════════════════════════════════════════
#  YOUR CRYPTO WALLETS — this is where the money lands
# ═════════════════════════════════════════════════════════════════════════════
# Paste your own receiving address for each coin you want to accept. Anything
# you leave blank is simply hidden from the checkout, so you can start with one
# and add the rest later.
#
# The address is published on the pay screen with an exact amount that is unique
# to that order — that unique amount is how an incoming transfer is matched back
# to the buyer, so one address serves every customer.
#
# DOUBLE-CHECK THE NETWORK ON EACH LINE. An address pasted against the wrong
# chain sends real money somewhere you cannot reach.

# USDT on TRON (TRC-20) — a TRON address, starts with T
WALLET_USDT_TRC20=
# USDT on Ethereum (ERC-20) — an Ethereum address, starts with 0x
WALLET_USDT_ERC20=
# Bitcoin — bc1... / 1... / 3...
WALLET_BTC=
# Ether on Ethereum mainnet — 0x...
WALLET_ETH=
# Solana — base58, ~44 characters
WALLET_SOL=
# Litecoin — ltc1... / L... / M...
WALLET_LTC=
# XRP Ledger — r...
WALLET_XRP=
# Optional: a destination tag, if your XRP address needs one (exchange deposits do)
WALLET_XRP_TAG=
# BNB on BNB Smart Chain (BEP-20) — 0x...
WALLET_BNB=
# USDC on BNB Smart Chain (BEP-20) — 0x...
WALLET_USDC_BEP20=
# TRX on TRON — starts with T
WALLET_TRX=

# ── Confirming those payments automatically ──────────────────────────────────
# TRON, Bitcoin, Litecoin, Solana and XRP confirm with no key at all.
#
# Ethereum and BNB Smart Chain need a free Etherscan key (one key covers both):
#   https://etherscan.io/apis
# Without it, ETH / USDT-ERC20 / BNB / USDC-BEP20 orders still work — the buyer
# submits the transaction hash and you approve it in Admin → Payments.
ETHERSCAN_API_KEY=

# Optional: raises the TronGrid rate limit — https://www.trongrid.io/
TRONGRID_API_KEY=
# Optional: your own RPC endpoints, if the public ones get rate-limited.
SOLANA_RPC_URL=
XRPL_RPC_URL=
# Optional: a CoinGecko demo key, used to quote the volatile coins in USD.
COINGECKO_API_KEY=

# ── NOWPayments (optional fallback) ──────────────────────────────────────────
# Only used for a coin you have NOT set a wallet for above. Leave blank to take
# every payment straight into your own wallets.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── Paystack (card + M-Pesa) ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
# Currency cards are charged in. Must be enabled on your Paystack account.
PAYSTACK_CURRENCY=USD
# Frontend base URL for Paystack's post-payment redirect (-> /app/checkout).
CHECKOUT_RETURN_URL=https://derivbot.app
# Fallback USD->KES rate for M-Pesa if the live FX lookup fails.
USD_KES_RATE=130

# ── Email receipts (Brevo) ───────────────────────────────────────────────────
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=TradeNexus
